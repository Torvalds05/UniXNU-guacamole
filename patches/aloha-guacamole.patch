index 76dcb4f9..abee912d 100644
--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -1,3 +1,12 @@
+/* UniXNU's bootimg driver compiles this with FD_BASE/FD_SIZE; the Aloha
+   build script uses UEFI_BASE/UEFI_SIZE. */
+#ifndef UEFI_BASE
+#define UEFI_BASE FD_BASE
+#endif
+#ifndef UEFI_SIZE
+#define UEFI_SIZE FD_SIZE
+#endif
+
 _Head:
 	/* Set _Entry address */
 	adr		x1, _Payload
@@ -34,6 +43,12 @@ _StackSize:
 	.long 0
 
 _Start:
+	/* Preserve the device-tree pointer for ShengBootMemoryDxe.
+	   0x9FF92000 is the reserved RAM Partition in the guacamole memory
+	   map; 0x9FFFF000 is the firmware Info Block and gets overwritten. */
+	movz	x6, #0x2000
+	movk	x6, #0x9FF9, lsl #16
+	str		x0, [x6]
 	mov		x4, x1
 	ldr		x5, _StackBase
 	cmp		x4, x5
