diff --git a/Resources/Scripts/mkbootimg.py b/Resources/Scripts/mkbootimg.py
new file mode 100755
index 00000000..f26046e1
--- /dev/null
+++ b/Resources/Scripts/mkbootimg.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Pack an Android v0 boot image with the Aloha guacamole header values.
+
+The prebuilt oneplus-guacamole_NOSB.img has kernel_addr 0x8000, tags 0x100,
+ramdisk_addr 0, page 4096 and header version 0. UniXNU's bootimg driver passes
+the same values from Resources/Configs/guacamole.toml.
+"""
+import argparse
+import hashlib
+import struct
+from pathlib import Path
+
+
+def integer(value):
+    return int(value, 0)
+
+
+def align(value, alignment):
+    return (value + alignment - 1) & ~(alignment - 1)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--kernel", required=True)
+    parser.add_argument("--ramdisk")
+    parser.add_argument("--second")
+    parser.add_argument("-o", "--output", required=True)
+    parser.add_argument("--base", type=integer, default=0)
+    parser.add_argument("--kernel_offset", "--kernel-offset", dest="kernel_offset", type=integer, default=0x8000)
+    parser.add_argument("--ramdisk_offset", "--ramdisk-offset", dest="ramdisk_offset", type=integer, default=0)
+    parser.add_argument("--second_offset", "--second-offset", dest="second_offset", type=integer, default=0)
+    parser.add_argument("--tags_offset", "--tags-offset", dest="tags_offset", type=integer, default=0x100)
+    parser.add_argument("--pagesize", type=integer, default=4096)
+    parser.add_argument("--header_version", "--header-version", dest="header_version", type=integer, default=0)
+    parser.add_argument("--os_version", "--os-version", dest="os_version", type=integer, default=0)
+    parser.add_argument("--cmdline", default="")
+    parser.add_argument("--name", default="")
+    args = parser.parse_args()
+
+    if args.header_version != 0:
+        raise SystemExit("mkbootimg: only Android header version 0 is implemented")
+
+    kernel = Path(args.kernel).read_bytes()
+    ramdisk = Path(args.ramdisk).read_bytes() if args.ramdisk else b""
+    second = Path(args.second).read_bytes() if args.second else b""
+    name = args.name.encode()[:15].ljust(16, b"\0")
+    cmdline = args.cmdline.encode()[:511].ljust(512, b"\0")
+    extra_cmdline = b"\0" * 1024
+    digest = hashlib.sha1(
+        kernel
+        + ramdisk
+        + second
+        + struct.pack("<I", len(kernel))
+        + struct.pack("<I", len(ramdisk))
+        + struct.pack("<I", len(second))
+    ).digest()
+
+    header = struct.pack(
+        "<8s10I16s512s8s1024s",
+        b"ANDROID!",
+        len(kernel),
+        args.base + args.kernel_offset,
+        len(ramdisk),
+        args.base + args.ramdisk_offset,
+        len(second),
+        args.base + args.second_offset,
+        args.base + args.tags_offset,
+        args.pagesize,
+        args.header_version,
+        args.os_version,
+        name,
+        cmdline,
+        digest,
+        extra_cmdline,
+    )
+    assert len(header) == 1608, len(header)
+
+    page = args.pagesize
+    image = bytearray()
+    image += header + b"\0" * (align(len(header), page) - len(header))
+    image += kernel + b"\0" * (align(len(kernel), page) - len(kernel))
+    image += ramdisk + b"\0" * (align(len(ramdisk), page) - len(ramdisk))
+    image += second + b"\0" * (align(len(second), page) - len(second))
+    Path(args.output).write_bytes(image)
+    print(f"{args.output}: {len(image)} bytes")
+
+
+if __name__ == "__main__":
+    main()
