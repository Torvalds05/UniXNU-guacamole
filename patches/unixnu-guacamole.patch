--- a/package/UniXNUPkg/Library/UniXNULib/Volume.c
+++ b/package/UniXNUPkg/Library/UniXNULib/Volume.c
@@ -153,13 +153,23 @@ OpenPath (
 {
   EFI_STATUS         Status;
   EFI_FILE_PROTOCOL  *Root;
+  CONST CHAR16       *Name;
 
   Status = OpenRoot (Volume, &Root);
   if (EFI_ERROR (Status)) {
     return Status;
   }
 
-  Status = Root->Open (Root, File, (CHAR16 *)Path, EFI_FILE_MODE_READ, 0);
+  //
+  // The path is relative to the volume root. Some FAT/FV drivers reject a
+  // leading backslash even though the config PCD spells the path absolute.
+  //
+  Name = Path;
+  while (*Name == L'\\') {
+    Name++;
+  }
+
+  Status = Root->Open (Root, File, (CHAR16 *)Name, EFI_FILE_MODE_READ, 0);
   Root->Close (Root);
   return Status;
 }
