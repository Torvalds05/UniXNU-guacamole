+#include <Guid/FileSystemInfo.h>
 #include <Library/FdtLib.h>
 
 //
@@ -1533,20 +1534,57 @@ UniXNUConfigLoad (
   TOML_NODE                  *Root;
   CHAR8                      Error[96];
   CHAR16                     Label[64];
+  BOOLEAN                    PayloadVolume;
 
   ZeroMem (Config, sizeof (*Config));
+  PayloadVolume = FALSE;
   Loaded = FALSE;
+  Config->VolumeCount = 0;
 
   //
   // The volume UniXNU was started from wins; then every other volume.
   //
   if (!EFI_ERROR (gBS->HandleProtocol (ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Self))) {
     Loaded = TryVolume (Config, Self->DeviceHandle);
+    if (Loaded) {
+      Config->VolumeCount = 1;
+    }
   }
 
   if (!Loaded && (Config->Error[0] == '\0')) {
     Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiSimpleFileSystemProtocolGuid, NULL, &Count, &Handles);
     if (!EFI_ERROR (Status)) {
+      Config->VolumeCount = Count;
+      for (Index = 0; Index < Count; Index++) {
+        EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs;
+        EFI_FILE_PROTOCOL                *Root;
+        EFI_FILE_SYSTEM_INFO             *Info;
+        UINTN                            InfoSize;
+        CHAR8                            Ascii[16];
+
+        if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs)) ||
+            EFI_ERROR (Fs->OpenVolume (Fs, &Root))) {
+          continue;
+        }
+
+        InfoSize = 0;
+        if (Root->GetInfo (Root, &gEfiFileSystemInfoGuid, &InfoSize, NULL) == EFI_BUFFER_TOO_SMALL) {
+          Info = AllocatePool (InfoSize);
+          if ((Info != NULL) && !EFI_ERROR (Root->GetInfo (Root, &gEfiFileSystemInfoGuid, &InfoSize, Info))) {
+            UnicodeStrToAsciiStrS (Info->VolumeLabel, Ascii, sizeof (Ascii));
+            if (AsciiStrnCmp (Ascii, "GUACESP", 7) == 0) {
+              PayloadVolume = TRUE;
+            }
+          }
+
+          if (Info != NULL) {
+            FreePool (Info);
+          }
+        }
+
+        Root->Close (Root);
+      }
+
       for (Index = 0; Index < Count && !Loaded && Config->Error[0] == '\0'; Index++) {
         Loaded = TryVolume (Config, Handles[Index]);
       }
@@ -1563,10 +1601,12 @@ UniXNUConfigLoad (
     // menu can show it.
     //
     CHAR8  Saved[sizeof (Config->Error)];
+    UINTN  VolumeCount = Config->VolumeCount;
 
     CopyMem (Saved, Config->Error, sizeof (Saved));
     ZeroMem (Config, sizeof (*Config));
     CopyMem (Config->Error, Saved, sizeof (Saved));
+    Config->VolumeCount = VolumeCount;
 
     Status = TomlParse (mBuiltinConfig, sizeof (mBuiltinConfig) - 1, &Root, Error, sizeof (Error));
     ASSERT_EFI_ERROR (Status);
@@ -1580,7 +1620,32 @@ UniXNUConfigLoad (
       // Only the actions are left. Say so instead of showing a menu that
       // looks complete.
       //
-      AsciiStrCpyS (Config->Notice, sizeof (Config->Notice), "no boot entry found");
+      {
+        volatile SHENG_STATUS  *Shim = (volatile SHENG_STATUS *)(UINTN)SHENG_STATUS_ADDR;
+        UINT32                 DtbValid = 0;
+        UINT32                 Initrd = 0;
+        UINT32                 Scan = 0;
+        UINT32                 Addr = 0;
+
+        if (Shim->Magic == SHENG_STATUS_MAGIC) {
+          DtbValid = Shim->DtbValid;
+          Initrd   = Shim->Initrd;
+          Scan     = Shim->Scan;
+          Addr     = (UINT32)Shim->Addr;
+        }
+
+        AsciiSPrint (
+          Config->Notice,
+          sizeof (Config->Notice),
+          "no boot entry found; volumes %u guac %u; shim d%u i%u s%u @%x",
+          (UINT32)Config->VolumeCount,
+          (UINT32)PayloadVolume,
+          DtbValid,
+          Initrd,
+          Scan,
+          Addr
+          );
+      }
       UniXNULog ("config: no boot entry found");
     }
 
